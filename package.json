{
  "name": "busybar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "vp run typecheck && vp run lint && vp run test && vp run build",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "format": "vp fmt",
    "lint": "vp lint src test",
    "start": "node dist/index.js",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@busy-app/busy-lib": "0.17.0",
    "pino": "^10.3.1",
    "protobufjs": "^8.0.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.6"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@9.15.0"
}
