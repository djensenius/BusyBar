NODE_ENV=production
LOG_LEVEL=info

BUSY_BAR_MONITOR_ENABLED=true
BUSY_BAR_CLOUD_TOKEN=
BUSY_BAR_API_URL=https://api.busy.app
BUSY_BAR_CLOUD_WS_URL=wss://api.busy.app/api/v1/bars/ws

BUSY_BAR_OPERATOR_API_URL=https://operator.example.com
BUSY_BAR_OPERATOR_TOKEN=
BUSY_BAR_BOOTH_ID=booth-01

# Optional; required only for physical encoder/button navigation.
BUSY_BAR_DEVICE_ID=
BUSY_BAR_APPLICATION_NAME=telephone-booth-monitor
BUSY_BAR_DISPLAY_PRIORITY=100

# Booth status heartbeats default to 30s; system snapshots default to 5s.
BUSY_BAR_STATUS_STALE_AFTER_SECONDS=75
BUSY_BAR_SYSTEM_STALE_AFTER_SECONDS=20
# Legacy shared fallback:
# BUSY_BAR_STALE_AFTER_SECONDS=45

BUSY_BAR_RENDER_DEBOUNCE_MS=250
BUSY_BAR_FRONT_ROTATION_SECONDS=8
BUSY_BAR_SUMMARY_POLL_SECONDS=30
BUSY_BAR_TIME_ZONE=America/Toronto

BUSY_BAR_AUDIO_ENABLED=false
BUSY_BAR_ALERT_SOUND=
BUSY_BAR_ALERT_COOLDOWN_SECONDS=300
